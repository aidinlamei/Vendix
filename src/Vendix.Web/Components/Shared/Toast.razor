@*
    Toast - Toast notification component
    Supports types: success, error, warning, info
*@
@implements IDisposable

@if (_isVisible)
{
    <div class="fixed bottom-4 right-4 z-50 animate-slide-in">
        <div class="@GetToastClasses() flex items-start p-4 rounded-lg shadow-lg max-w-sm">
            <!-- Icon -->
            <div class="flex-shrink-0">
                @switch (Type.ToLower())
                {
                    case "success":
                        <svg class="h-5 w-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        break;
                    case "error":
                        <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        break;
                    case "warning":
                        <svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        break;
                    default:
                        <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        break;
                }
            </div>

            <!-- Content -->
            <div class="ml-3 flex-1">
                @if (!string.IsNullOrEmpty(Title))
                {
                    <p class="text-sm font-medium @GetTitleClasses()">@Title</p>
                }
                <p class="@(string.IsNullOrEmpty(Title) ? "" : "mt-1") text-sm @GetMessageClasses()">@Message</p>
            </div>

            <!-- Close Button -->
            <button @onclick="Close" class="ml-4 flex-shrink-0 inline-flex text-gray-400 hover:text-gray-600 focus:outline-none">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
    </div>
}

<style>
    @@keyframes slide-in {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    .animate-slide-in {
        animation: slide-in 0.3s ease-out;
    }
</style>

@code {
    private bool _isVisible;
    private CancellationTokenSource? _cancellationTokenSource;

    /// <summary>
    /// Toast type: success, error, warning, info.
    /// </summary>
    [Parameter]
    public string Type { get; set; } = "info";

    /// <summary>
    /// Optional title for the toast.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// Message to display.
    /// </summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>
    /// Duration in milliseconds before auto-hide. Set to 0 to disable.
    /// </summary>
    [Parameter]
    public int Duration { get; set; } = 5000;

    /// <summary>
    /// Event callback when toast is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _isVisible = true;

        if (Duration > 0)
        {
            _cancellationTokenSource = new CancellationTokenSource();
            try
            {
                await Task.Delay(Duration, _cancellationTokenSource.Token);
                await Close();
            }
            catch (TaskCanceledException)
            {
                // Task was cancelled, which is expected when manually closing
            }
        }
    }

    /// <summary>
    /// Shows the toast notification.
    /// </summary>
    public void Show()
    {
        _isVisible = true;
        StateHasChanged();
    }

    /// <summary>
    /// Closes the toast notification.
    /// </summary>
    public async Task Close()
    {
        _isVisible = false;
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
        _cancellationTokenSource = null;
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    private string GetToastClasses() => Type.ToLower() switch
    {
        "success" => "bg-green-50 border border-green-200",
        "error" => "bg-red-50 border border-red-200",
        "warning" => "bg-yellow-50 border border-yellow-200",
        _ => "bg-blue-50 border border-blue-200"
    };

    private string GetTitleClasses() => Type.ToLower() switch
    {
        "success" => "text-green-800",
        "error" => "text-red-800",
        "warning" => "text-yellow-800",
        _ => "text-blue-800"
    };

    private string GetMessageClasses() => Type.ToLower() switch
    {
        "success" => "text-green-700",
        "error" => "text-red-700",
        "warning" => "text-yellow-700",
        _ => "text-blue-700"
    };

    public void Dispose()
    {
        _cancellationTokenSource?.Cancel();
        _cancellationTokenSource?.Dispose();
    }
}

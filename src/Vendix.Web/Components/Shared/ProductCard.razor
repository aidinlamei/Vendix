@using Vendix.Application.Catalog.DTOs
@inject CartService CartService
@inject ToastService ToastService

<div class="group bg-white rounded-lg shadow-sm hover:shadow-md transition overflow-hidden flex flex-col">
    <!-- Image -->
    <a href="/product/@Product.Slug" class="block">
        <div class="aspect-square bg-gray-100 relative overflow-hidden">
            @if (!string.IsNullOrEmpty(Product.MainImageUrl))
            {
                <img src="@Product.MainImageUrl" alt="@Product.Name"
                     class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                     onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-gray-400\'><svg class=\'h-16 w-16\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\' /></svg></div>';" />
            }
            else
            {
                <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
            }

            <!-- Stock Badge -->
            @if (Product.HasVariants && Product.TotalStock <= 0)
            {
                <div class="absolute top-2 right-2 bg-red-500 text-white text-xs px-2 py-1 rounded">
                    Out of Stock
                </div>
            }
            else if (Product.HasVariants && Product.TotalStock < 10)
            {
                <div class="absolute top-2 right-2 bg-yellow-500 text-white text-xs px-2 py-1 rounded">
                    Low Stock
                </div>
            }
        </div>
    </a>

    <!-- Info -->
    <div class="p-4 flex flex-col flex-1">
        <a href="/product/@Product.Slug" class="block">
            <!-- Category -->
            @if (!string.IsNullOrEmpty(Product.CategoryName))
            {
                <p class="text-xs text-gray-500 mb-1">@Product.CategoryName</p>
            }

            <!-- Title -->
            <h3 class="font-medium text-gray-900 group-hover:text-primary-600 transition line-clamp-2">
                @Product.Title
            </h3>

            <!-- Price -->
            <div class="mt-2">
                <PriceDisplay Price="@Product.Price" Currency="@Product.Currency" />
            </div>
        </a>

        <!-- Add to Cart -->
        <button @onclick="AddToCart"
                class="mt-3 w-full inline-flex items-center justify-center gap-2 bg-primary-600 text-white py-2 px-4 rounded-lg font-medium hover:bg-primary-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition"
                disabled="@(Product.HasVariants && Product.TotalStock <= 0)">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Add to Cart
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductListDto Product { get; set; } = default!;

    private async Task AddToCart()
    {
        var added = await CartService.AddAsync(new CartItem
        {
            ProductId = Product.Id,
            Slug = Product.Slug,
            Name = Product.Title,
            Sku = Product.Sku,
            Price = Product.Price,
            Currency = Product.Currency,
            ImageUrl = Product.MainImageUrl,
            Quantity = 1
        });

        if (added)
        {
            ToastService.ShowSuccess($"\"{Product.Title}\" added to cart.");
        }
        else
        {
            ToastService.ShowError("Could not add this product to your cart.");
        }
    }
}

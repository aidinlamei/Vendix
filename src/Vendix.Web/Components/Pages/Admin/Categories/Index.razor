@page "/admin/categories"
@layout AdminLayout

@using MediatR
@using Vendix.Application.Catalog.DTOs
@using Vendix.Application.Catalog.Queries
@using Vendix.Application.Catalog.Commands
@using Vendix.Web.Components.Shared
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Categories - Vendix Admin</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Categories</h1>
            <p class="text-gray-600 mt-1">Manage product categories and hierarchy</p>
        </div>
        <a href="/admin/categories/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Category
        </a>
    </div>

    <!-- Category Tree -->
    @if (_isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner Size="large" Text="Loading categories..." />
        </div>
    }
    else if (_categories.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-12 text-center">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No categories yet</h3>
            <p class="text-gray-600 mb-4">Get started by creating your first category.</p>
            <a href="/admin/categories/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">
                Create Category
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">@_categories.Count root categories</span>
                    <button @onclick="ExpandAll" class="text-sm text-primary-600 hover:text-primary-700">
                        Expand All
                    </button>
                </div>
            </div>
            <div class="divide-y divide-gray-200">
                @foreach (var category in _categories)
                {
                    <CategoryTreeNode Category="category" 
                                      Level="0" 
                                      OnEdit="EditCategory" 
                                      OnDelete="ShowDeleteConfirm"
                                      ExpandedIds="_expandedIds" />
                }
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog IsVisible="_showDeleteConfirm"
               Title="Delete Category"
               Message="@($"Are you sure you want to delete '{_categoryToDelete?.Name}'? This action cannot be undone.")"
               Type="danger"
               ConfirmText="Delete"
               OnConfirm="DeleteCategory"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private List<CategoryTreeDto> _categories = [];
    private bool _isLoading = true;
    private bool _showDeleteConfirm;
    private CategoryTreeDto? _categoryToDelete;
    private HashSet<Guid> _expandedIds = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        _isLoading = true;
        try
        {
            _categories = await Mediator.Send(new GetCategoryTreeQuery());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void EditCategory(Guid id)
    {
        Navigation.NavigateTo($"/admin/categories/edit/{id}");
    }

    private void ShowDeleteConfirm(CategoryTreeDto category)
    {
        _categoryToDelete = category;
        _showDeleteConfirm = true;
    }

    private async Task DeleteCategory()
    {
        if (_categoryToDelete is null) return;

        try
        {
            await Mediator.Send(new DeleteCategoryCommand(_categoryToDelete.Id));
            await LoadCategories();
        }
        catch (Exception ex)
        {
            // TODO: Show error toast
            Console.WriteLine($"Error deleting category: {ex.Message}");
        }
        finally
        {
            _showDeleteConfirm = false;
            _categoryToDelete = null;
        }
    }

    private void ExpandAll()
    {
        _expandedIds = GetAllIds(_categories);
    }

    private HashSet<Guid> GetAllIds(List<CategoryTreeDto> categories)
    {
        var ids = new HashSet<Guid>();
        foreach (var cat in categories)
        {
            ids.Add(cat.Id);
            if (cat.Children.Count > 0)
            {
                foreach (var childId in GetAllIds(cat.Children))
                {
                    ids.Add(childId);
                }
            }
        }
        return ids;
    }
}


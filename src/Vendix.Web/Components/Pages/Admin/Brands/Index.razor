@page "/admin/brands"
@layout AdminLayout

@using MediatR
@using Vendix.Application.Catalog.DTOs
@using Vendix.Application.Catalog.Queries
@using Vendix.Application.Catalog.Commands
@using Vendix.Web.Components.Shared
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Brands - Vendix Admin</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Brands</h1>
            <p class="text-gray-600 mt-1">Manage product brands</p>
        </div>
        <a href="/admin/brands/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Brand
        </a>
    </div>

    <!-- Brand List -->
    @if (_isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner Size="large" Text="Loading brands..." />
        </div>
    }
    else if (_brands.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-12 text-center">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No brands yet</h3>
            <p class="text-gray-600 mb-4">Get started by creating your first brand.</p>
            <a href="/admin/brands/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">
                Create Brand
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Brand
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Slug
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Products
                        </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            Actions
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var brand in _brands)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                                    {
                                        <img src="@brand.LogoUrl" alt="@brand.Name" class="w-10 h-10 rounded-lg object-cover mr-4" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mr-4">
                                            <span class="text-primary-600 font-bold text-lg">@brand.Name[0]</span>
                                        </div>
                                    }
                                    <div class="text-sm font-medium text-gray-900">@brand.Name</div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-500">/@brand.Slug</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                    @brand.ProductCount products
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button @onclick="() => EditBrand(brand.Id)" 
                                        class="text-primary-600 hover:text-primary-900 mr-4">
                                    Edit
                                </button>
                                <button @onclick="() => ShowDeleteConfirm(brand)" 
                                        class="text-red-600 hover:text-red-900">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog IsVisible="_showDeleteConfirm"
               Title="Delete Brand"
               Message="@($"Are you sure you want to delete '{_brandToDelete?.Name}'? This action cannot be undone.")"
               Type="danger"
               ConfirmText="Delete"
               OnConfirm="DeleteBrand"
               OnCancel="() => _showDeleteConfirm = false" />

@if (_showToast)
{
    <Toast Type="@_toastType" Title="@_toastTitle" Message="@_toastMessage" Duration="5000" OnClose="HandleToastClose" />
}

@code {
    private List<BrandListDto> _brands = [];
    private bool _isLoading = true;
    private bool _showDeleteConfirm;
    private BrandListDto? _brandToDelete;
    private bool _showToast;
    private string _toastType = "error";
    private string _toastTitle = "Error";
    private string _toastMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBrands();
    }

    private async Task LoadBrands()
    {
        _isLoading = true;
        try
        {
            _brands = await Mediator.Send(new GetBrandsQuery());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void EditBrand(Guid id)
    {
        Navigation.NavigateTo($"/admin/brands/edit/{id}");
    }

    private void ShowDeleteConfirm(BrandListDto brand)
    {
        _brandToDelete = brand;
        _showDeleteConfirm = true;
    }

    private async Task DeleteBrand()
    {
        if (_brandToDelete is null) return;

        try
        {
            await Mediator.Send(new DeleteBrandCommand(_brandToDelete.Id));
            await LoadBrands();
        }
        catch (Exception ex)
        {
            ShowErrorToast("Failed to delete brand", ex.Message);
        }
        finally
        {
            _showDeleteConfirm = false;
            _brandToDelete = null;
        }
    }

    private void ShowErrorToast(string title, string message)
    {
        _toastType = "error";
        _toastTitle = title;
        _toastMessage = message;
        _showToast = true;
        StateHasChanged();
    }

    private void HandleToastClose()
    {
        _showToast = false;
        StateHasChanged();
    }
}


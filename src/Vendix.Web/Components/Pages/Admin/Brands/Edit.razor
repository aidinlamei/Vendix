@page "/admin/brands/edit/{Id:guid}"
@layout AdminLayout

@using MediatR
@using Vendix.Application.Catalog.Commands
@using Vendix.Application.Catalog.DTOs
@using Vendix.Application.Catalog.Queries
@using Vendix.Web.Components.Shared
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Edit Brand - Vendix Admin</PageTitle>

@if (_isLoading)
{
    <div class="flex justify-center py-12">
        <LoadingSpinner Size="large" Text="Loading brand..." />
    </div>
}
else if (_brand is null)
{
    <div class="text-center py-12">
        <h2 class="text-xl font-medium text-gray-900">Brand not found</h2>
        <a href="/admin/brands" class="text-primary-600 hover:text-primary-700 mt-4 inline-block">
            Back to Brands
        </a>
    </div>
}
else
{
    <div class="max-w-2xl mx-auto space-y-6">
        <!-- Header -->
        <div class="flex items-center space-x-4">
            <a href="/admin/brands" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Edit Brand</h1>
                <p class="text-gray-600 mt-1">Update @_brand.Name</p>
            </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-lg shadow">
            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="p-6 space-y-6">
                <DataAnnotationsValidator />

                <!-- Name -->
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                        Name <span class="text-red-500">*</span>
                    </label>
                    <InputText id="name" @bind-Value="_model.Name" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    <ValidationMessage For="() => _model.Name" class="text-red-500 text-sm mt-1" />
                </div>

                <!-- Slug -->
                <div>
                    <label for="slug" class="block text-sm font-medium text-gray-700 mb-1">
                        Slug
                    </label>
                    <div class="flex items-center">
                        <span class="px-3 py-2 bg-gray-100 border border-r-0 border-gray-300 rounded-l-lg text-gray-500">/brands/</span>
                        <InputText id="slug" @bind-Value="_model.Slug" 
                                   class="flex-1 px-4 py-2 border border-gray-300 rounded-r-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    </div>
                </div>

                <!-- Logo Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Logo</label>
                    <ImageUpload CurrentImageUrl="@_model.LogoUrl"
                                 Folder="brands"
                                 Alt="Brand Logo"
                                 OnImageUploaded="HandleLogoUploaded"
                                 OnImageRemoved="HandleLogoRemoved"
                                 HelpText="Square image recommended (max 5MB)" />
                </div>

                <!-- Actions -->
                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <a href="/admin/brands" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" disabled="@_isSubmitting"
                            class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed">
                        @if (_isSubmitting)
                        {
                            <span class="inline-flex items-center">
                                <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                Saving...
                            </span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showToast)
{
    <Toast Type="@_toastType" Title="@_toastTitle" Message="@_toastMessage" Duration="5000" OnClose="HandleToastClose" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private BrandDto? _brand;
    private BrandFormModel _model = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _showToast;
    private string _toastType = "error";
    private string _toastTitle = "Error";
    private string _toastMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadBrand();
    }

    private async Task LoadBrand()
    {
        _isLoading = true;
        try
        {
            _brand = await Mediator.Send(new GetBrandByIdQuery(Id));
            if (_brand is not null)
            {
                _model = new BrandFormModel
                {
                    Name = _brand.Name,
                    Slug = _brand.Slug,
                    LogoUrl = _brand.LogoUrl
                };
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        try
        {
            var command = new UpdateBrandCommand
            {
                Id = Id,
                Name = _model.Name,
                Slug = _model.Slug,
                LogoUrl = string.IsNullOrWhiteSpace(_model.LogoUrl) ? null : _model.LogoUrl
            };

            var result = await Mediator.Send(command);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/admin/brands");
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast("Failed to update brand", ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleLogoUploaded(string url)
    {
        _model.LogoUrl = url;
    }

    private void HandleLogoRemoved()
    {
        _model.LogoUrl = null;
    }

    private void ShowErrorToast(string title, string message)
    {
        _toastType = "error";
        _toastTitle = title;
        _toastMessage = message;
        _showToast = true;
        StateHasChanged();
    }

    private void HandleToastClose()
    {
        _showToast = false;
        StateHasChanged();
    }

    private class BrandFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Slug { get; set; }
        public string? LogoUrl { get; set; }
    }
}


@page "/admin/products"
@layout AdminLayout

@using MediatR
@using Vendix.Application.Catalog.DTOs
@using Vendix.Application.Catalog.Queries
@using Vendix.Application.Catalog.Commands
@using Vendix.Application.Common.Models
@using Vendix.Web.Components.Shared
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Products - Vendix Admin</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Products</h1>
            <p class="text-gray-600 mt-1">Manage your product catalog</p>
        </div>
        <a href="/admin/products/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add Product
        </a>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow p-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Search -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Search</label>
                <input type="text" @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp"
                       placeholder="Product name or SKU..."
                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500" />
            </div>
            
            <!-- Category Filter -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select @bind="_selectedCategoryId" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                    <option value="">All Categories</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id.ToString()">@category.Name</option>
                    }
                </select>
            </div>
            
            <!-- Brand Filter -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Brand</label>
                <select @bind="_selectedBrandId" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                    <option value="">All Brands</option>
                    @foreach (var brand in _brands)
                    {
                        <option value="@brand.Id.ToString()">@brand.Name</option>
                    }
                </select>
            </div>
            
            <!-- Filter Button -->
            <div class="flex items-end">
                <button @onclick="ApplyFilters" class="w-full px-4 py-2 bg-secondary-600 text-white rounded-lg hover:bg-secondary-700">
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    <!-- Product List -->
    @if (_isLoading)
    {
        <div class="flex justify-center py-12">
            <LoadingSpinner Size="large" Text="Loading products..." />
        </div>
    }
    else if (_products.Items.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-12 text-center">
            <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No products found</h3>
            <p class="text-gray-600 mb-4">Get started by creating your first product.</p>
            <a href="/admin/products/create" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700">
                Create Product
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Stock</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var product in _products.Items)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    @if (!string.IsNullOrEmpty(product.MainImageUrl))
                                    {
                                        <img src="@product.MainImageUrl" alt="@product.Name" class="w-12 h-12 rounded-lg object-cover mr-4" />
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 bg-gray-200 rounded-lg flex items-center justify-center mr-4">
                                            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                        </div>
                                    }
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">@product.Name</div>
                                        <div class="text-sm text-gray-500">/@product.Slug</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-900 font-mono">@product.Sku</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-600">@(product.CategoryName ?? "-")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm font-medium text-gray-900">@product.Price.ToString("C")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (product.TotalStock <= 0)
                                {
                                    <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded-full">Out of Stock</span>
                                }
                                else if (product.TotalStock < 10)
                                {
                                    <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full">Low: @product.TotalStock</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">@product.TotalStock in stock</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (product.IsActive)
                                {
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">Active</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-800 rounded-full">Draft</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <button @onclick="() => EditProduct(product.Id)" class="text-primary-600 hover:text-primary-900 mr-4">Edit</button>
                                <button @onclick="() => ShowDeleteConfirm(product)" class="text-red-600 hover:text-red-900">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <!-- Pagination -->
            @if (_products.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t">
                    <Pagination CurrentPage="_products.PageNumber"
                                TotalPages="_products.TotalPages"
                                TotalCount="_products.TotalCount"
                                PageSize="_pageSize"
                                OnPageChanged="OnPageChanged" />
                </div>
            }
        </div>
    }
</div>

<!-- Delete Confirmation -->
<ConfirmDialog IsVisible="_showDeleteConfirm"
               Title="Delete Product"
               Message="@($"Are you sure you want to delete '{_productToDelete?.Name}'? This action cannot be undone.")"
               Type="danger"
               ConfirmText="Delete"
               OnConfirm="DeleteProduct"
               OnCancel="() => _showDeleteConfirm = false" />

@code {
    private PaginatedList<ProductListDto> _products = PaginatedList<ProductListDto>.Empty();
    private List<CategoryListDto> _categories = [];
    private List<BrandListDto> _brands = [];
    
    private bool _isLoading = true;
    private bool _showDeleteConfirm;
    private ProductListDto? _productToDelete;
    
    private string _searchTerm = string.Empty;
    private Guid? _selectedCategoryId;
    private Guid? _selectedBrandId;
    private int _currentPage = 1;
    private int _pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadFilters();
        await LoadProducts();
    }

    private async Task LoadFilters()
    {
        try
        {
            var categoriesTask = Mediator.Send(new GetCategoriesQuery());
            var brandsTask = Mediator.Send(new GetBrandsQuery());
            
            await Task.WhenAll(categoriesTask, brandsTask);
            
            _categories = await categoriesTask;
            _brands = await brandsTask;
        }
        catch (Exception ex)
        {
            // TODO: Show error toast
            Console.WriteLine($"Error loading filters: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        try
        {
            _products = await Mediator.Send(new GetProductsQuery(
                PageNumber: _currentPage,
                PageSize: _pageSize,
                SearchTerm: string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
                CategoryId: _selectedCategoryId,
                BrandId: _selectedBrandId
            ));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadProducts();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadProducts();
    }

    private void EditProduct(Guid id)
    {
        Navigation.NavigateTo($"/admin/products/edit/{id}");
    }

    private void ShowDeleteConfirm(ProductListDto product)
    {
        _productToDelete = product;
        _showDeleteConfirm = true;
    }

    private async Task DeleteProduct()
    {
        if (_productToDelete is null) return;

        try
        {
            await Mediator.Send(new DeleteProductCommand(_productToDelete.Id));
            await LoadProducts();
        }
        catch (Exception ex)
        {
            // TODO: Show error toast
            Console.WriteLine($"Error deleting product: {ex.Message}");
        }
        finally
        {
            _showDeleteConfirm = false;
            _productToDelete = null;
        }
    }
}


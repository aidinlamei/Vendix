@page "/product/{Slug}"
@using MediatR
@using Vendix.Application.Catalog.Queries
@using Vendix.Application.Catalog.DTOs
@using Vendix.Application.Common.Models
@using Vendix.Domain.Catalog.Enums
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject CartService CartService
@inject ToastService ToastService

<PageTitle>@(_product?.Name ?? "Product") - Vendix</PageTitle>

@if (_isLoading)
{
    <div class="flex justify-center py-24">
        <LoadingSpinner Size="large" />
    </div>
}
else if (_product is null)
{
    <div class="max-w-7xl mx-auto px-4 py-16 text-center">
        <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Product not found</h1>
        <p class="mt-2 text-gray-500">The product you're looking for doesn't exist or has been removed.</p>
        <a href="/products" class="mt-6 inline-block bg-primary-600 text-white px-6 py-3 rounded-lg hover:bg-primary-700">
            Browse Products
        </a>
    </div>
}
else
{
    <div class="bg-white">
        <!-- Breadcrumb -->
        <div class="border-b">
            <div class="max-w-7xl mx-auto px-4 py-3">
                <nav class="flex text-sm text-gray-500">
                    <a href="/" class="hover:text-primary-600">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/products" class="hover:text-primary-600">Products</a>
                    @if (_product.CategoryName is not null)
                    {
                        <span class="mx-2">/</span>
                        <a href="/products/category/@_product.CategorySlug" class="hover:text-primary-600">
                            @_product.CategoryName
                        </a>
                    }
                    <span class="mx-2">/</span>
                    <span class="text-gray-900">@_product.Name</span>
                </nav>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 py-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <!-- Image Gallery -->
                <div>
                    <!-- Main Image -->
                    <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden mb-4">
                        @if (!string.IsNullOrEmpty(_selectedImage))
                        {
                            <img src="@_selectedImage" alt="@_product.Name" 
                                 class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-gray-400">
                                <svg class="h-24 w-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        }
                    </div>
                    
                    <!-- Thumbnails -->
                    @if (_product.Images?.Count > 1)
                    {
                        <div class="grid grid-cols-4 gap-2">
                            @foreach (var image in _product.Images.OrderBy(i => i.SortOrder))
                            {
                                <button @onclick="() => SelectImage(image.Url)"
                                        class="aspect-square rounded-lg overflow-hidden border-2 @(image.Url == _selectedImage ? "border-primary-500" : "border-transparent hover:border-gray-300")">
                                    <img src="@image.Url" alt="@image.AltText" class="w-full h-full object-cover" />
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Product Info -->
                <div>
                    <!-- Title & SKU -->
                    <div class="mb-4">
                        <p class="text-sm text-gray-500 mb-1">SKU: @_product.Sku</p>
                        <h1 class="text-3xl font-bold text-gray-900">@GetTitle()</h1>
                    </div>

                    <!-- Brand -->
                    @if (_product.BrandName is not null)
                    {
                        <a href="/products/brand/@_product.BrandSlug" 
                           class="inline-block text-sm text-primary-600 hover:text-primary-700 mb-4">
                            @_product.BrandName
                        </a>
                    }

                    <!-- Price -->
                    <div class="mb-6">
                        <PriceDisplay Price="@_product.Price" 
                                      Currency="@_product.Currency" 
                                      Size="large" />
                    </div>

                    <!-- Stock Status -->
                    <div class="mb-6">
                        @{
                            var totalStock = _product.Variants?.Sum(v => v.StockQuantity) ?? 0;
                        }
                        @if (totalStock <= 0)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                </svg>
                                Out of Stock
                            </span>
                        }
                        else if (totalStock < 10)
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                Only @totalStock left
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                In Stock
                            </span>
                        }
                    </div>

                    <!-- Description -->
                    @if (!string.IsNullOrEmpty(GetDescription()))
                    {
                        <div class="mb-6">
                            <h2 class="text-lg font-medium text-gray-900 mb-2">Description</h2>
                            <div class="prose prose-sm text-gray-600">
                                @((MarkupString)GetDescription()!)
                            </div>
                        </div>
                    }

                    <!-- Add to Cart (UI only - Phase 3) -->
                    <div class="flex items-center gap-4 mb-6">
                        <div class="flex items-center border rounded-lg">
                            <button @onclick="DecrementQuantity" 
                                    class="px-4 py-2 text-gray-600 hover:bg-gray-100 disabled:opacity-50"
                                    disabled="@(_quantity <= 1)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                </svg>
                            </button>
                            <span class="px-4 py-2 font-medium">@_quantity</span>
                            <button @onclick="IncrementQuantity" 
                                    class="px-4 py-2 text-gray-600 hover:bg-gray-100 disabled:opacity-50"
                                    disabled="@(_quantity >= totalStock)">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                            </button>
                        </div>
                        
                        <button @onclick="AddToCart" class="flex-1 bg-primary-600 text-white py-3 px-6 rounded-lg font-medium hover:bg-primary-700 disabled:bg-gray-300 disabled:cursor-not-allowed transition"
                                disabled="@(totalStock <= 0)">
                            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                            Add to Cart
                        </button>
                    </div>

                    <!-- Product Type -->
                    <div class="border-t pt-4">
                        <p class="text-sm text-gray-500">
                            <span class="font-medium">Type:</span> 
                            @(_product.ProductType == ProductType.Digital ? "Digital Product" : "Physical Product")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Specifications -->
            @if (_product.Specifications?.Any() == true)
            {
                <div class="mt-12 border-t pt-8">
                    <h2 class="text-xl font-bold text-gray-900 mb-4">Specifications</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var spec in _product.Specifications)
                        {
                            <div class="flex border-b py-2">
                                <span class="w-1/3 text-gray-500">@spec.Name</span>
                                <span class="w-2/3 font-medium">@spec.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private ProductDto? _product;
    private string? _selectedImage;
    private bool _isLoading = true;
    private int _quantity = 1;
    private string _currentLanguage = "en"; // TODO: Get from settings/user preference

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await Mediator.Send(new GetProductBySlugQuery(Slug));
            if (result.IsSuccess)
            {
                _product = result.Value;
                _selectedImage = _product?.Images?.FirstOrDefault(i => i.IsMain)?.Url 
                                ?? _product?.Images?.FirstOrDefault()?.Url;
            }
        }
        catch
        {
            // Product not found - handled in UI
            _product = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectImage(string url)
    {
        _selectedImage = url;
    }

    private void IncrementQuantity()
    {
        var totalStock = _product?.Variants?.Sum(v => v.StockQuantity) ?? 0;
        if (_product is not null && _quantity < totalStock)
            _quantity++;
    }

    private void DecrementQuantity()
    {
        if (_quantity > 1)
            _quantity--;
    }

    private async Task AddToCart()
    {
        if (_product is null)
            return;

        await CartService.AddAsync(new CartItem
        {
            ProductId = _product.Id,
            Slug = _product.Slug,
            Name = GetTitle(),
            Sku = _product.Sku,
            Price = _product.Price,
            Currency = _product.Currency,
            ImageUrl = _selectedImage,
            Quantity = _quantity
        });

        ToastService.ShowSuccess($"\"{GetTitle()}\" added to cart.");
    }

    private string GetTitle()
    {
        if (_product?.Translations is null) return _product?.Name ?? "";
        
        var translation = _product.Translations.FirstOrDefault(t => t.LanguageCode == _currentLanguage)
                         ?? _product.Translations.FirstOrDefault();
        
        return translation?.Title ?? _product.Name;
    }

    private string? GetDescription()
    {
        if (_product?.Translations is null) return _product?.Description;
        
        var translation = _product.Translations.FirstOrDefault(t => t.LanguageCode == _currentLanguage)
                         ?? _product.Translations.FirstOrDefault();
        
        return translation?.Description ?? _product.Description;
    }
}


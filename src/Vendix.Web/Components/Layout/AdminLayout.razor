@inherits LayoutComponentBase

@*
    AdminLayout - Admin panel layout for Vendix e-commerce platform
    Features: Collapsible sidebar, top bar, responsive design
*@

<div class="min-h-screen flex bg-gray-100">
    <!-- Sidebar -->
    <aside class="@(_isSidebarCollapsed ? "w-16" : "w-64") bg-secondary-900 text-white transition-all duration-300 ease-in-out fixed inset-y-0 left-0 z-50 md:relative md:translate-x-0 @(_isMobileSidebarOpen ? "translate-x-0" : "-translate-x-full md:translate-x-0")">
        <!-- Logo -->
        <div class="flex items-center justify-between h-16 px-4 bg-secondary-800">
            @if (!_isSidebarCollapsed)
            {
                <a href="/admin" class="flex items-center">
                    <svg class="h-8 w-8 text-primary-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                    <span class="ml-2 text-xl font-bold">Vendix</span>
                </a>
            }
            else
            {
                <a href="/admin" class="mx-auto">
                    <svg class="h-8 w-8 text-primary-400" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                </a>
            }

            <!-- Collapse Button (Desktop) -->
            <button @onclick="ToggleSidebar" class="hidden md:block p-1 rounded hover:bg-secondary-700 transition">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    @if (_isSidebarCollapsed)
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                    }
                    else
                    {
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
                    }
                </svg>
            </button>

            <!-- Close Button (Mobile) -->
            <button @onclick="CloseMobileSidebar" class="md:hidden p-1 rounded hover:bg-secondary-700 transition">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="mt-4 px-2">
            <div class="space-y-1">
                <NavLink href="/admin" Match="NavLinkMatch.All" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Dashboard</span>
                    }
                </NavLink>

                <NavLink href="/admin/products" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Products</span>
                    }
                </NavLink>

                <NavLink href="/admin/categories" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Categories</span>
                    }
                </NavLink>

                <NavLink href="/admin/orders" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Orders</span>
                    }
                </NavLink>

                <NavLink href="/admin/customers" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Customers</span>
                    }
                </NavLink>

                <!-- Divider -->
                <div class="my-4 border-t border-secondary-700"></div>

                <NavLink href="/admin/settings" class="nav-link group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                    <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    @if (!_isSidebarCollapsed)
                    {
                        <span class="ml-3">Settings</span>
                    }
                </NavLink>
            </div>
        </nav>

        <!-- Back to Store -->
        <div class="absolute bottom-4 left-0 right-0 px-2">
            <a href="/" class="group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg hover:bg-secondary-800 transition">
                <svg class="h-5 w-5 text-secondary-400 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
                </svg>
                @if (!_isSidebarCollapsed)
                {
                    <span class="ml-3">Back to Store</span>
                }
            </a>
        </div>
    </aside>

    <!-- Overlay for mobile -->
    @if (_isMobileSidebarOpen)
    {
        <div @onclick="CloseMobileSidebar" class="fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden"></div>
    }

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col @(_isSidebarCollapsed ? "md:ml-0" : "md:ml-0")">
        <!-- Top Bar -->
        <header class="bg-white shadow-sm h-16 flex items-center justify-between px-4 sticky top-0 z-30">
            <!-- Mobile Menu Button -->
            <button @onclick="OpenMobileSidebar" class="md:hidden p-2 rounded-lg hover:bg-gray-100 transition">
                <svg class="h-6 w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>

            <!-- Page Title -->
            <div class="hidden md:block">
                <h1 class="text-lg font-semibold text-gray-800">Admin Panel</h1>
            </div>

            <!-- Right Side -->
            <div class="flex items-center space-x-4">
                <!-- Notifications -->
                <button class="relative p-2 text-gray-600 hover:text-primary-600 hover:bg-gray-100 rounded-lg transition">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                    </svg>
                    <span class="absolute top-1 right-1 h-2 w-2 bg-error rounded-full"></span>
                </button>

                <!-- User Dropdown -->
                <div class="relative">
                    <button @onclick="ToggleUserMenu" class="flex items-center space-x-3 p-2 rounded-lg hover:bg-gray-100 transition">
                        <div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center">
                            <span class="text-white text-sm font-medium">A</span>
                        </div>
                        <div class="hidden md:block text-left">
                            <p class="text-sm font-medium text-gray-700">Admin User</p>
                            <p class="text-xs text-gray-500">admin@vendix.com</p>
                        </div>
                        <svg class="h-4 w-4 text-gray-400 hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>

                    @if (_isUserMenuOpen)
                    {
                        <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1 z-50">
                            <a href="/admin/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Profile</a>
                            <a href="/admin/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
                            <div class="border-t border-gray-200 my-1"></div>
                            <a href="/logout" class="block px-4 py-2 text-sm text-error hover:bg-gray-100">Logout</a>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-6">
            @Body
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 py-4 px-6">
            <p class="text-sm text-gray-500 text-center">
                &copy; @DateTime.Now.Year Vendix Admin. All rights reserved.
            </p>
        </footer>
    </div>
</div>

<style>
    .nav-link.active {
        background-color: rgba(59, 130, 246, 0.1);
        color: #60a5fa;
    }
    .nav-link.active svg {
        color: #60a5fa;
    }
</style>

@code {
    private bool _isSidebarCollapsed;
    private bool _isMobileSidebarOpen;
    private bool _isUserMenuOpen;

    /// <summary>
    /// Toggles the sidebar collapsed state (desktop).
    /// </summary>
    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    /// <summary>
    /// Opens the mobile sidebar.
    /// </summary>
    private void OpenMobileSidebar()
    {
        _isMobileSidebarOpen = true;
    }

    /// <summary>
    /// Closes the mobile sidebar.
    /// </summary>
    private void CloseMobileSidebar()
    {
        _isMobileSidebarOpen = false;
    }

    /// <summary>
    /// Toggles the user dropdown menu.
    /// </summary>
    private void ToggleUserMenu()
    {
        _isUserMenuOpen = !_isUserMenuOpen;
    }
}
